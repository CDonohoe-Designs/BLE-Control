###############################################################################
# OS junk
###############################################################################
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes
# Editors/IDEs
.vscode/
.idea/
*.code-workspace

###############################################################################
# Altium Designer (AD25)
###############################################################################

# Per-project generated folders
**/Project Outputs*/
**/Project Outputs for*/
**/Project Logs*/
**/Project Logs for*/
**/Simulation Logs*/
**/Generated/
**/Generated Documents/
**/Reports/
**/__Previews/
**/__Previews__/
**/History/

Hardware/Altium/Outputs/
Hardware/Altium/Releases/
Hardware/Altium/__Previews/
Hardware/Altium/Generated/
Hardware/Altium/Generated Documents/

# Compiled/derived libraries
# Keep LibPkg + source SchLib/PcbLib in git.
*.IntLib

# Ignore the staging area under Altium libraries
Hardware/Altium/Libraries/_staging/

# Per-doc previews / structural caches
**/*.SchDocPreview
**/*.PcbDocPreview
**/*.PrjPcbStructure
**/*.PrjPcbVariants

# Variant output folders
**/Variants*/

# Altium generated reports / logs
*MessageListReport*
*Design Rule Check*
*Design Rule Verification Report*
*.DRC
*.ERC
*.REP
*.rpt
*.log
*.LOG
*.err

# Temporary / backup files
*.~*
*.tmp
*.bak
*.orig
*.rej

# Draftsman / release exports
# Do NOT globally ignore PDFs because schematic PDFs are useful in the repo.
# Keep formal exports under Docs/ or Hardware/Altium/ when intentional.
# Ignore generated release packages only:
Hardware/Altium/Outputs/**/*.csv
Hardware/Altium/Releases/**/*.csv
Hardware/Altium/Outputs/**/*.xlsx
Hardware/Altium/Releases/**/*.xlsx
Hardware/Altium/Outputs/**/*.zip
Hardware/Altium/Releases/**/*.zip
Hardware/Altium/Outputs/**/*.PDF
Hardware/Altium/Releases/**/*.PDF
Hardware/Altium/Outputs/**/*.STEP
Hardware/Altium/Releases/**/*.STEP
Hardware/Altium/Outputs/**/*.STP
Hardware/Altium/Releases/**/*.STP
Hardware/Altium/Outputs/**/*.DXF
Hardware/Altium/Releases/**/*.DXF

###############################################################################
# STM32CubeIDE / build artifacts
###############################################################################
# Build dirs
Firmware/**/Debug/
Firmware/**/Release/
Firmware/**/build/

# Tooling metadata
Firmware/**/.settings/
Firmware/**/.externalToolBuilders/
# Local launch/debug configs (keep project files like .project/.cproject/.ioc)
Firmware/**/*.launch
Firmware/**/.mxproject.user

# Binaries / maps
**/*.elf
**/*.axf
**/*.bin
**/*.hex
**/*.map
**/*.lst
**/*.list

###############################################################################
# Python / notebooks (if you use analysis scripts)
###############################################################################
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/.ipynb_checkpoints/

###############################################################################
# Office temp/lock & generic temp/bak
###############################################################################
~$*.docx
~$*.xlsx
*.tmp
*.bak
*.orig
*.rej

###############################################################################
# Generated artifacts inside Outputs/Releases only
###############################################################################
# Keep CSV/XLSX design sources elsewhere (e.g., Libraries/Database) tracked.
Hardware/Altium/Outputs/**/*.csv
Hardware/Altium/Releases/**/*.csv
Hardware/Altium/Outputs/**/*.xlsx
Hardware/Altium/Releases/**/*.xlsx
Hardware/Altium/Outputs/**/*.zip
Hardware/Altium/Releases/**/*.zip

###############################################################################
# Misc logs
###############################################################################
*.log

